# Copy to .env. Generate secrets: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
POSTGRES_USER=island
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_DB=island
DATABASE_URL=postgresql://island:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5432/island
TEST_DATABASE_URL=postgresql://island:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:5432/island_test
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://127.0.0.1:8081
# Required for multi-instance operation; leave empty for single API development.
REDIS_URL=
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Future phase, not used by current release:
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
