{
  "name": "@island/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "node --watch --env-file=../../.env dist/main.js",
    "start": "node dist/main.js",
    "migrate": "node --env-file=../../.env dist/scripts/migrate.js",
    "admin:create": "node --env-file=../../.env dist/scripts/admin.js",
    "test": "node --test dist/test/unit.test.js",
    "test:integration": "node --env-file=../../.env --test dist/test/integration.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/websockets": "^12.1.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "express": "5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "redis": "^5.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "socket.io-client": "^4.8.1",
    "typescript": "^5.9.3"
  }
}
